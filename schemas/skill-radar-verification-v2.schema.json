{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.dailyingest.cn/schemas/skill-radar-verification-v2.schema.json",
  "title": "Skill Radar adjudicated multi-agent source verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reportDate", "profile", "runs", "results"],
  "properties": {
    "version": { "const": 2 },
    "reportDate": { "type": "string", "format": "date" },
    "profile": { "const": "multi-agent-harness-v2" },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "specialist", "adjudicator"],
      "properties": {
        "primary": { "$ref": "#/$defs/run" },
        "specialist": { "$ref": "#/$defs/run" },
        "adjudicator": { "$ref": "#/$defs/run" }
      }
    },
    "results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "materialField": {
      "enum": [
        "verdict", "currentUrl", "artifactPath", "repositoryStatus",
        "sourceRepositoryChanged", "identityChanged"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "available", "completed", "freshContextRequested", "retryCount", "notes"],
      "properties": {
        "attempted": { "type": "boolean" },
        "available": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "freshContextRequested": { "type": "boolean" },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict", "originalUrlStatus", "currentTitle", "currentUrl",
        "artifactPath", "skillMdVerified", "repositoryStatus",
        "sourceRepositoryChanged", "identityChanged", "license", "capability", "usability",
        "portability", "maintenance", "trustCaveat", "evidence"
      ],
      "properties": {
        "verdict": {
          "enum": ["verified_current", "recovered_current", "migrated", "ambiguous", "invalid", "inconclusive"]
        },
        "originalUrlStatus": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "enum": ["unavailable", "unknown"] }
          ]
        },
        "currentTitle": { "type": ["string", "null"] },
        "currentUrl": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "artifactPath": { "type": ["string", "null"] },
        "skillMdVerified": { "type": "boolean" },
        "repositoryStatus": { "enum": ["current", "deprecated", "archived", "missing", "unknown"] },
        "sourceRepositoryChanged": { "type": "boolean" },
        "identityChanged": { "type": "boolean" },
        "license": { "type": ["string", "null"] },
        "capability": { "type": "string", "minLength": 8 },
        "usability": { "type": "string", "minLength": 8 },
        "portability": { "type": "string", "minLength": 8 },
        "maintenance": { "type": "string", "minLength": 8 },
        "trustCaveat": { "type": "string", "minLength": 8 },
        "evidence": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 12 }
        }
      }
    },
    "disputeQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "question"],
      "properties": {
        "field": { "$ref": "#/$defs/materialField" },
        "question": { "type": "string", "minLength": 12 }
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "questions", "evidencePolicy", "maxAdjudicationAttempts"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/materialField" }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/disputeQuestion" }
        },
        "evidencePolicy": { "const": "first_party_only" },
        "maxAdjudicationAttempts": { "const": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId", "artifactKey", "title", "originalSourceUrl",
        "originalArtifactPath", "primary", "specialistRequired", "specialist",
        "disagreementFields", "dispute", "adjudicationRequired",
        "adjudication", "reconciled", "disposition", "removalReason",
        "requiresFollowup"
      ],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^src_[a-f0-9]{8}$" },
        "artifactKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "originalSourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "originalArtifactPath": { "type": ["string", "null"] },
        "primary": { "$ref": "#/$defs/evidence" },
        "specialistRequired": { "type": "boolean" },
        "specialist": { "oneOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }] },
        "disagreementFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/materialField" }
        },
        "dispute": { "oneOf": [{ "$ref": "#/$defs/dispute" }, { "type": "null" }] },
        "adjudicationRequired": { "type": "boolean" },
        "adjudication": { "oneOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }] },
        "reconciled": { "$ref": "#/$defs/evidence" },
        "disposition": { "enum": ["retained", "removed"] },
        "removalReason": {
          "oneOf": [
            {
              "enum": [
                "primary_unresolved", "adjudication_unresolved",
                "invalid_artifact", "verification_contract_failure"
              ]
            },
            { "type": "null" }
          ]
        },
        "requiresFollowup": { "type": "boolean" }
      }
    }
  }
}
